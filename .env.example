# ProofScale (Ratecap) Environment Configuration Example
# Copy to .env and configure for your deployment environment

# Node Environment
NODE_ENV=production

# Server Listen Port
PORT=3001

# Application URLs
VITE_APP_URL=https://app.proofscale.dev

# Database Configuration
# PostgreSQL / Supabase Connection String (Use least-privilege role 'ratecap_app' in production)
DATABASE_URL=postgresql://ratecap_app:CHANGE_ME_IN_PRODUCTION@localhost:5432/proofscale
# For local SQLite development:
# SQLITE_PATH=./proofscale.sqlite

# Security & CORS Lockdown
# Comma-separated list of exact authorized frontend origins (wildcard disallowed with credentials)
ALLOWED_ORIGINS=https://app.proofscale.dev,http://localhost:5173

# Transport Security
# Force HSTS headers (enabled by default in production)
HSTS_ENABLED=true

# Payment Webhook Verification
# Shared HMAC-SHA256 secret for Stripe / payment provider webhook verification
PAYMENT_WEBHOOK_SECRET=whsec_replace_with_actual_payment_webhook_signing_secret

# Worker Configuration
WORKER_CONCURRENCY=2
POLL_INTERVAL_MS=2000
